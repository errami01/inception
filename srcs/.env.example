# .env.example - Commit this file to GitHub/GitLab
DOMAIN_NAME=login.42.fr

# MariaDB Configuration
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
MYSQL_PASSWORD=your_user_password_here
MYSQL_ROOT_PASSWORD=your_root_password_here

# WordPress Configuration
WP_TITLE=Inception

# WordPress Admin (Must not contain 'admin' or 'administrator' in the username for security)
WP_ADMIN_USER=your_admin_login_here
WP_ADMIN_PASSWORD=your_admin_password_here
WP_ADMIN_EMAIL=admin@example.com

# WordPress Ordinary User
WP_USER=your_regular_user_here
WP_USER_PASSWORD=your_regular_user_password_here
WP_USER_EMAIL=user@example.com
